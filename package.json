{
  "name": "laundry-platform",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/app.js",
    "dev": "node --watch server/app.js",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "backup": "node scripts/backup.mjs",
    "format": "prettier --write \"{book,owner,rider,shared,server,setup,scripts,test}/**/*.{js,mjs,css,html}\" index.html sw.js"
  },
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "devDependencies": {
    "playwright": "1.58.2",
    "prettier": "3.6.2"
  }
}
